# BookWise AI — Environment Variables Configuration

# Paths (optional overrides)
# PDF_PATH=data/History_2024-25.pdf
# CHROMA_PERSIST_DIR=chroma_db

# Generation Configuration
# Supported providers: "local" (default deterministic grounded extractor), "gemini", "openai"
LLM_PROVIDER=local

# API Keys (Optional - only required if LLM_PROVIDER is set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Retrieval Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
RETRIEVAL_THRESHOLD=0.42
